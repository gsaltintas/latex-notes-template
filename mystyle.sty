% ===== Emphasis box (unchanged — no numbering, purely visual callout) =====
\newtcolorbox{emphbox}[1][]{
    enhanced,breakable,
    colback=BackgroundColor,
    colframe=TextColor,
    boxrule=1pt,
    left=1em, right=1em, top=0.8em, bottom=0.8em,
    sharp corners,
    #1
}

% ===== Experiment box =====
% For describing a planned or completed experiment, its setup, and what it tests
\newtcolorbox[auto counter, number within=section]{experimentbox}[1][]{
    enhanced,breakable,
    colback=CalmBlue!30,
    colframe=CalmBlue,
    colbacktitle=CalmBlue,
    coltitle=white,
    fonttitle=\bfseries,
    title={\emoji{test-tube} Experiment~\thetcbcounter},
    attach boxed title to top left={xshift=1em, yshift=-\tcboxedtitleheight/2},
    boxed title style={boxrule=0pt, colframe=CalmBlue, sharp corners},
    top=1.5em,
    #1
}

% ===== Result box =====
% For reporting empirical findings, measured outcomes, or experiment results
\newtcolorbox[auto counter, number within=section]{resultbox}[1][]{
    enhanced,breakable,
    colback=Teal!30,
    colframe=Teal,
    colbacktitle=Teal,
    coltitle=white,
    fonttitle=\bfseries,
    title={\emoji{bar-chart} Result~\thetcbcounter},
    attach boxed title to top left={xshift=1em, yshift=-\tcboxedtitleheight/2},
    boxed title style={boxrule=0pt, colframe=Teal, sharp corners},
    top=1.5em,
    #1
}

% ===== Comment / dialogue command =====
% Usage: \commentbox[GS]{Revisit this after the ablation.}
%        \commentbox{No attribution, falls back to "Comment"}
\NewDocumentCommand{\commentbox}{ O{Comment} m }{%
    \par\noindent
    \begin{tcolorbox}[
        enhanced, breakable,
        colback=PaleGray,
        colframe=SlateGray,
        coltitle=white,
        fonttitle=\bfseries,
        colbacktitle=SlateGray,
        top=0.3em, bottom=0.3em, left=0.5em, right=0.5em,
        boxsep=2pt,
        title={\emoji{speech-balloon}~#1},
        titlerule=0pt,
        width=\linewidth,
        halign=left,
    ]
    #2
    \end{tcolorbox}
    \par\noindent\ignorespaces
}

\endinput